# Peblo TV Mini - Environment Variables
# Copy this file to .env and fill in real values.

# ===== Database =====
# Local development (docker-compose):
DATABASE_URL=postgresql+asyncpg://peblo:peblo_secret@localhost:5432/peblo_tv
# In docker-compose, the API uses db as the host.

# ===== Auth (JWT) =====
# !! In production this MUST be a long random string (e.g. openssl rand -hex 48) !!
JWT_SECRET_KEY=change-me-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# ===== Storage =====
# local = write to a local directory (docker volume or filesystem)
# r2    = Cloudflare R2 (S3-compatible)
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage

# R2 credentials (only needed when STORAGE_BACKEND=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=peblo-tv-catalogue

# ===== CORS =====
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Seeding =====
# Seed the database with seed_shows.json on startup (first boot only)
SEED_ON_START=true

# ffmpeg binary used to generate playable placeholder demo clips at boot.
# Leave as "ffmpeg" when it is on PATH (it is installed in the API Docker image);
# set an absolute path for portable installs, or "" to skip video generation.
FFMPEG_BIN=ffmpeg

# ===== Frontend =====
# VITE_API_URL is an env var the React apps read at build time.
# It should point to the FastAPI URL, e.g. http://localhost:8000
VITE_API_URL=http://localhost:8000
